# Copy to .env and uncomment what you need. Every value here is the default.
# Full list and the reasoning behind each default: src/config.py.

# --- Engine ---
# llama = MiniCPM-V 4.7 on a managed llama-server (default); ollama = any Ollama vision model.
# VLM_BACKEND=llama
# Use a llama-server you run yourself instead of the managed one:
# LLAMA_HOST=http://127.0.0.1:8080
# LLAMA_PORT=11471
# LLAMA_CTX=8192
# LLAMA_MODELS_DIR=~/Library/Application Support/VLM Media Tagger/models
# LLAMA_SERVER_BIN=/path/to/llama-server
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_VISION_MODEL=openbmb/minicpm-v4.5
# Force a prompt set instead of following the model (minicpm-v4.7 | minicpm-v4.5):
# PROMPT_SET=

# --- Output ---
# OUTPUT_LANGUAGE=en
# FILTER_PROFANITY=false
# Comma-separated sink names or module:Class specs (see docs/adr/0003-macos-app-and-output-sinks.md):
# OUTPUT_SINKS=sidecar

# --- Paths ---
# DATA_DIR=./data
# TRANSLATION_MODELS_DIR=
# VMT_APP_SUPPORT_DIR=~/Library/Application Support/VLM Media Tagger

# --- Performance ---
# 1 is measured: parallel requests were slower (docs/findings.md).
# PARALLEL_WORKERS=1
